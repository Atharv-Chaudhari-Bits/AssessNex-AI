# AssessNex AI - active configuration
APP_NAME=AssessNex AI
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Gemini is the only active provider
LLM_PROVIDER=google
ENABLE_PROVIDER_GEMINI=true
ENABLE_PROVIDER_OPENAI=false
ENABLE_PROVIDER_GROK=false
ENABLE_PROVIDER_GROQ=false

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_SECONDS=2
LLM_RETRY_MAX_SECONDS=30
REQUEST_TIMEOUT=120

# Features
ENABLE_DOCUMENT_RAG=false
ENABLE_IMAGE_QUESTIONS=false
ENABLE_ASSIGNMENT_GENERATION=true
ENABLE_QUESTION_PAPER_GENERATION=true
ENABLE_PLAGIARISM_CHECK=false
ENABLE_LEGACY_STREAMLIT_FRONTEND=false

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# --- Production AI / assessment controls ---
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_FALLBACK_MODEL=
ENABLE_QUALITY_CHECK=true
ENABLE_MATH_VALIDATION=true
ENABLE_VISUAL_GENERATION=true
ENABLE_PAPER_EXPORTS=true
ENABLE_QUESTION_BANK=true
ENABLE_MULTI_VERSION_PAPERS=true
PAPER_QUALITY_THRESHOLD=85
PAPER_MAX_VERSIONS=4
PAPER_JOB_TTL_SECONDS=3600
PAPER_POLL_INTERVAL_SECONDS=1.0
QUESTION_BANK_DB_PATH=data/question_bank.sqlite3
VISUAL_RENDER_DPI=150
VISUAL_MAX_POINTS=1000
# Evaluation
ENABLE_EVALUATION=true
ENABLE_EVALUATION_GEMINI=true
EVALUATION_PASS_PERCENT=40
